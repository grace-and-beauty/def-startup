# Copy to .env.local and fill in. Never commit real values.

# Public URL of the app (links in QR codes, wallet passes, magic-link redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase project (Settings → API). The anon key is public by design; RLS protects data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only — bypasses RLS. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Staff scanner session (HS256 cookie). ≥ 32 random bytes, e.g. `openssl rand -base64 48`
STAFF_SESSION_SECRET=
# HMAC key for hashing client IPs (staff PIN lockout, join rate limit) — we never store raw IPs.
# Required: without it the scanner login and /c/[slug] refuse requests.
IP_HASH_SECRET=
# Bearer token Vercel Cron sends to /api/cron/reminders (daily, vercel.json).
# Empty → the endpoint answers 503. e.g. `openssl rand -hex 32`
CRON_SECRET=
# Minimum minutes between two stamps on one card (0 disables; useful for local tests)
STAMP_COOLDOWN_MINUTES=10

# Google Wallet. Leave empty → noop provider: no "Add to Google Wallet" button, web card only.
# NEXT_PUBLIC_SITE_URL must then be a public https URL (JWT origins, default pass logo).
GOOGLE_WALLET_ISSUER_ID=
GOOGLE_WALLET_SERVICE_ACCOUNT_EMAIL=
# PEM private key of the service account, newlines escaped as \n
GOOGLE_WALLET_PRIVATE_KEY=

# Tests: plain Postgres used by `npm run db:test:up` and integration tests
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/loyalty_test

# Service admin dashboard /admin: comma-separated emails allowed in.
# Empty → /admin answers 404 to everyone. Sign in on /login with one of them.
ADMIN_EMAILS=
